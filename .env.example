# --- Runtime -------------------------------------------------------------
APP_ENV=production            # production refuses AUTH_DISABLED
ROLE=all                      # all | api | worker
PORT=8080                     # injected by Railway
DATABASE_URL=                 # ${{Postgres.DATABASE_URL}} on Railway; empty = in-memory (dev only)
DB_MAX_CONNS=20
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text
# GOMEMLIMIT is derived from the container limit (90%) when unset.

# --- API -----------------------------------------------------------------
API_KEYS=                     # comma-separated "id:key" (key >= 24 chars). id "admin" sees every job.
API_RATE_PER_KEY=20           # requests/s per key (burst = 2x)
CORS_ORIGINS=                 # e.g. https://app.cleads.fr
MAX_RESULTS_CAP=50000
WEBHOOK_SECRET=               # HMAC-SHA256 secret for X-Cleads-Signature
SHUTDOWN_WINDOW=25s
PPROF_ADDR=                   # e.g. 127.0.0.1:6060 (never expose publicly)
PUBLIC_URL=                   # public base URL, e.g. https://cleads-api.up.railway.app (export download links given to agents)

# --- Observability ---------------------------------------------------------
WORKER_ID=                    # process name in events/heartbeats (default: RAILWAY_REPLICA_ID, else host-pid)
EVENTS_RETENTION=168h         # WARN+ log events kept in the events table (purged hourly)
EVENTS_BUFFER=4096            # queued events before dropping (cleads_log_events_total{outcome="dropped"})
LOG_RING_SIZE=1000            # recent INFO+ records kept in memory per process (GET /v1/logs?local=true)

# --- MCP (Model Context Protocol, see docs/MCP.md) ----------------------------
MCP_ENABLED=true              # serve /mcp (roles api and all)
MCP_ALLOWED_ORIGINS=          # browser origins allowed to call /mcp (CORS_ORIGINS are allowed too)
MCP_MAX_WAIT=120s             # cap of wait_for_job
# stdio mode (cleads-mcp / cleads-extractor mcp), on the client machine:
# CLEADS_URL=https://cleads-api.up.railway.app
# CLEADS_API_KEY=
# CLEADS_MCP_MAX_WAIT=120s

# --- Sources -------------------------------------------------------------
ENABLE_GMAPS_SCRAPING=true    # google_maps_http — default Google source, no API key (see docs/COMPLIANCE.md)
GMAPS_DETAILS=true            # fetch the full place profile of every result (reviews, photos, attributes...)
GMAPS_MAX_PAGES=6             # 20 results per page per grid cell
GMAPS_PROXIES=                # http://user:pass@host:port,socks5://host:port (rotated per connection)
GMAPS_DEBUG_DIR=              # save payloads the parser rejects, for diagnosis
GOOGLE_PLACES_API_KEY=        # optional: official Places API source
PLACES_FIELD_TIER=contact     # contact (phone/website, higher SKU) | basic
ENABLE_OSM=true
OVERPASS_URL=                 # comma-separated; default = public instances with failover
ENABLE_SIRENE=true
SIRENE_URL=
GMAPS_SCRAPER_URL=            # google_maps_browser sidecar, e.g. http://gmaps-scraper.railway.internal:8080
GMAPS_SCRAPER_EMAIL=false
ENABLE_MOCK_SOURCE=false

# --- Engine --------------------------------------------------------------
GEOCODER=                     # google | nominatim | none (default: google if key else nominatim)
GEOCODER_USER_AGENT=CLEADS-Business-Extractor/1.0 (contact@your-domain)
ENRICH_ENABLED=true
ENRICH_CONCURRENCY=32
ENRICH_MAX_PAGES=4
SOURCE_CONCURRENCY=           # e.g. google_places=16,osm=2
SOURCE_RATE=                  # req/s per worker (default google_maps_http=8, measured safe up to ~20 from one IP)
MAX_CELLS_PER_JOB=2500
DEDUP_CACHE_SIZE=2000000
PLAN_CONCURRENCY=4
TASK_LEASE=2m
