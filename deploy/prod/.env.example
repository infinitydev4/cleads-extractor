# Template of /opt/cleads/.env. init-env.sh creates the real file with
# generated secrets; never commit it.

# --- Deployment ---------------------------------------------------------------
DOMAIN=vps-xxxxxxxx.vps.ovh.net          # public host name served by Caddy (TLS)
IMAGE=ghcr.io/infinitydev4/cleads-extractor
IMAGE_TAG=latest                          # written by deploy.sh (rollback target = previous value)
PUBLIC_URL=https://vps-xxxxxxxx.vps.ovh.net

# --- Secrets (generated) --------------------------------------------------------
POSTGRES_PASSWORD=                        # letters and digits only (used inside DATABASE_URL)
API_KEYS=admin:<key>,crm:<key>            # "id:key", key >= 24 chars; id "admin" sees every job and the logs
WEBHOOK_SECRET=

# --- Identity towards third parties ----------------------------------------------
GEOCODER_USER_AGENT=CLEADS-Business-Extractor/1.0 (+https://github.com/infinitydev4/cleads-extractor)

# --- Scraping ---------------------------------------------------------------------
# Conservative until the IP of this server has been measured against Google
# (docs/BENCHMARKS.md); raise it step by step while watching
# cleads_source_requests_total{outcome=~"blocked|rate_limited"}.
SOURCE_RATE=google_maps_http=4
SOURCE_CONCURRENCY=
GMAPS_PROXIES=                            # http://user:pass@host:port,... (recommended beyond a few req/s)
GMAPS_DETAILS=true
ENABLE_GMAPS_SCRAPING=true
ENABLE_OSM=true
ENABLE_SIRENE=true
ENRICH_ENABLED=true
ENRICH_CONCURRENCY=8                      # sites crawled in parallel; 130-185% CPU of 2 vCPU was measured at 32
GOOGLE_PLACES_API_KEY=                    # optional official source

# --- Optional ----------------------------------------------------------------------
LOG_LEVEL=info
DB_MAX_CONNS=20
MCP_ALLOWED_ORIGINS=
CORS_ORIGINS=
